Page Prepare variant=studio-workbench
  Section id=printer-rail
  Stack variant=stage
    Row variant=toolstrip
      Input type=file name=modelFile variant=import label="Add model" accept=".stl,.3mf"
      If condition=$workspace
        Button variant=tool action=openDrive aria-label="Open from Drive"
          Icon name=FolderOpen size=22
      Button variant=tool action=newPlate aria-label="New plate"
        Icon name=Grid2X2 size=24
      Divider
      Button variant=tool action=arrange disabled=$notEditable aria-label="Arrange objects"
        Icon name=LayoutGrid size=23
      Button variant=tool action=toggleTransform disabled=$notEditable aria-label="Move, rotate and scale"
        Icon name=Move size=23
      Button variant=tool action=duplicate disabled=$notEditable aria-label="Duplicate object"
        Icon name=Copy size=23
      Button variant=tool action=remove disabled=$notEditable aria-label="Remove object"
        Icon name=Trash2 size=23
      Button variant=tool action=fitView aria-label="Fit plate to view"
        Icon name=Scan size=23
      Button variant=tool action=topView aria-label="Top view"
        Icon name=Box size=23
      Spacer
      Badge $plateLabel
    Section id=scene
    If condition=$noObjects
      Stack variant=stage-empty
        Icon name=Box size=40
        Heading level=1 "Prepare your plate"
        Text "Add an STL or Bambu 3MF model to begin."
    If condition=$showTransform
      Card variant=transform
        Heading level=3 "Move, rotate & scale"
        Field label=Object
          Select name=objectID options=$objectOptions
        Grid columns=3
          Field label="X (mm)"
            Input name=x type=number step=1
          Field label="Y (mm)"
            Input name=y type=number step=1
          Field label="Z (mm)"
            Input name=z type=number step=1
          Field label="Rotate X (°)"
            Input name=rx type=number step=5
          Field label="Rotate Y (°)"
            Input name=ry type=number step=5
          Field label="Rotate Z (°)"
            Input name=rz type=number step=5
          Field label="Scale (%)"
            Input name=scale type=number min=1 max=10000
        Row
          Button action=transform "Apply changes"
          Button variant=secondary action=reset "Reset position"
          Button variant=secondary action=toggleTransform cancel=true "Close"
    Row variant=stage-status
      Text variant=caption $sceneNotice
      Spacer
      If condition=$importNotice
        Text variant=caption $importNotice
