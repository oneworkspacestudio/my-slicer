Page Slicer
  Row gap=md
    Stack gap=xs
      Heading level=1 "Prepare your next print"
      Text "Your models, your printers. Powered by the native Bambu Studio engine."
    Spacer
    Button variant=primary action=newProject "New project"
  Row gap=md
    Link href=$sourceURL external=true "Application source · AGPL-3.0"
    Link href=$engineSource external=true "Native engine source"
  If condition=$engineNeeded
    Card
      Heading level=2 "Set up the slicing engine"
      Text $engine.message
      Text $engineProgress
      Section id=engine-progress
      Text "One-time download: 474 MB. Installed runtime: about 570 MB. Both printer profiles are sliced and checked before activation."
      If condition=$owner
        Button variant=primary action=installEngine disabled=$engine.busy "Install verified engine"
        If condition=$engine.busy
          Button action=cancelEngine cancel=true "Cancel setup"
      Else
        Text "Ask the Workspace owner to finish engine setup."
  Row gap=md
    Field label=Project
      Select name=projectID options=$projectOptions
    Field label="Project name"
      Input name=projectName
    Button action=renameProject "Rename"
  If condition=$hasProject
    Grid columns=2 variant=slicer
      Stack gap=md
        Card
          Row
            Heading level=2 "Build plate"
            Spacer
            Badge $revisionText
          Section id=scene
          Text variant=caption $sceneNotice
          Row gap=sm
            Field label="Add STL or Bambu 3MF"
              Input type=file name=modelFile accept=".stl,.3mf"
            Button action=upload disabled=$noFile "Add model"
            If condition=$workspace
              Button action=openDrive "Open from Drive"
          If condition=$importNotice
            Alert $importNotice
          Field label="Object"
            Select name=objectID options=$objectOptions
          If condition=$editable
            Grid columns=3
              Field label="X (mm)"
                Input name=x type=number step=1
              Field label="Y (mm)"
                Input name=y type=number step=1
              Field label="Z (mm)"
                Input name=z type=number step=1
              Field label="Rotate X (°)"
                Input name=rx type=number step=5
              Field label="Rotate Y (°)"
                Input name=ry type=number step=5
              Field label="Rotate Z (°)"
                Input name=rz type=number step=5
              Field label="Scale (%)"
                Input name=scale type=number min=1 max=10000
            Row gap=sm
              Button action=transform "Apply transform"
              Button action=duplicate "Duplicate"
              Button action=reset "Reset"
              Button action=remove "Remove"
              Button action=arrange "Arrange"
              Button action=undo disabled=$noUndo "Undo"
        If condition=$activeSlice
          Card
            Heading level=2 "Native slice"
            Text $activeSlice.message
            Text $sliceElapsed
            If condition=$slicing
              Button action=cancelSlice "Cancel slicing"
            If condition=$sliceReady
              Row gap=md
                Metric value=$timeText
                Text $filamentText
                Badge $layerCount
              Field label="Preview layer"
                Input name=layer type=range min=1 max=$maxLayer step=1
              Text $layerText
              Field label="Toolpath feature"
                Select name=feature options=$featureOptions
              Row
                Button action=downloadSlice "Download sliced 3MF"
                Button variant=primary action=reviewPrint disabled=$staleSlice "Review & print"
              If condition=$staleSlice
                Alert tone=warning "This slice is from an older revision or has no paired target. Select a printer and slice again."
      Stack gap=md
        Card
          Heading level=2 "Print settings"
          Field label="Target printer"
            Select name=target options=$printerOptions
          Field label="Printer model"
            Select name=model options=$modelOptions disabled=$hasTarget
          Field label="Nozzle"
            Select name=nozzle options=$nozzleOptions disabled=true
          Text variant=caption "Only the verified 0.4 mm profiles are currently enabled. Confirm the actual nozzle and plate in printer setup."
          Field label="Build plate"
            Select name=plate options=$plateOptions disabled=$hasTarget
          If condition=$nativeProject
            Field label="Project plate"
              Select name=nativePlate options=$nativePlates
            Checkbox name=preserveImported label="Preserve native 3MF settings, modifiers and painting"
          Field label="Quality profile"
            Select name=quality options=$processOptions disabled=$preserving
          Field label="Filament profile (STL / single-material override)"
            Select name=filament options=$filamentOptions disabled=$preserving
          Grid columns=2
            Field label="Layer height (mm)"
              Input name=layerHeight type=number step=0.01 min=0.08 max=0.28 disabled=$preserving
            Field label="Infill (%)"
              Input name=infill type=number min=0 max=100 disabled=$preserving
            Field label="Walls"
              Input name=walls type=number min=1 max=20 disabled=$preserving
            Field label=Brim
              Select name=brim options=$brimOptions disabled=$preserving
          Checkbox name=supports label="Generate supports" disabled=$preserving
          Row
            Button action=saveSettings "Save settings"
            Button variant=primary action=slice disabled=$cannotSlice "Slice plate"
          Text variant=caption "Changes create a new revision. Slicing uses immutable models and settings; an old result cannot start a new revision."
        Card
          Row
            Heading level=2 "Your printers"
            Spacer
            Button action=addPrinter "Add printer"
          For each=$printers
            Stack gap=xs
              Row
                Text $item.config.name
                Badge $item.status.status
                Button item=$item.config.id action=editPrinter "Setup & diagnostics"
              Text variant=caption $item.detail
              For each=$item.diagnostics
                Text $item.message
          If condition=$noPrinters
            Text "Add your A1 or A1 mini. Upload and start stay local to your network."
        For each=$prints
          Card
            Row
              Heading level=3 $item.state
              Badge $item.printerName
            Text $item.message
            Text $item.progressText
            Row gap=sm
              Button item=$item.id action=pause "Pause"
              Button item=$item.id action=resume "Resume"
              Button item=$item.id action=cancelPrint "Cancel print…"
              Button item=$item.id action=reconcile "Refresh status"
              If condition=$item.unknown
                Button item=$item.id action=resolve "Resolve uncertain start…"
        If condition=$workspace
          Card
            Heading level=2 "Drive copies"
            Text "Originals and completed sliced archives are saved as ordinary files in Drive while this app is open."
            For each=$driveSaves
              Row
                Text $item.name
                Badge $item.state
                Text $item.message
            Button action=retryDrive "Retry pending copies"
        Card
          Heading level=2 "Recent slices"
          For each=$projectSlices
            Row
              Text $item.label
              Button item=$item.id action=selectSlice "View"
              Button item=$item.id action=deleteSlice "Remove result"
  If condition=$printerDialog
    Card variant=dialog aria-label="Printer setup"
      Heading level=2 "Connect your printer"
      Alert tone=error $error
      Alert "On the printer, enable LAN Only and Developer Mode where available. LAN Only disables Bambu Handy/cloud access. No firmware changes are made here."
      Button action=discover "Find printers on this network"
      For each=$discovered
        Button item=$item.serial action=chooseDiscovered $item.label
      Grid columns=2
        Field label="Printer name"
          Input name=printerName
        Field label="Model"
          Select name=printerModel options=$modelOptions
        Field label="Local IP or hostname"
          Input name=printerHost
        Field label="Serial from printer screen"
          Input name=printerSerial
        Field label="LAN access code"
          Input type=password name=accessCode autoComplete=new-password
        Field label="Physical build plate"
          Select name=printerPlate options=$plateOptions
      Checkbox name=nozzleConfirmed label="I checked that the installed nozzle is 0.4 mm"
      Checkbox name=developerConfirmed label="I enabled local commands / Developer Mode on this printer"
      Checkbox name=manualIdentity label="I checked the serial and model on the physical screen (for firmware without discovery)"
      Checkbox name=protectedData label="Use encrypted FTPS data channel (only if this firmware supports it)"
      Text variant=caption "Access codes are encrypted for this Windows user, never stored in browser storage. A blank code keeps the existing saved code."
      Row
        Button variant=primary action=savePrinter "Save printer"
        Button action=probe disabled=$noPrinterID "Inspect certificates"
        Button action=testPrinter disabled=$noPrinterID "Test connections"
      If condition=$trust
        Alert tone=warning "Review the two local certificate fingerprints against this device before trusting. A changed certificate requires review again."
        Text variant=code $trustText
        Checkbox name=trustConfirmed label="I confirm these certificates belong to my selected printer"
        Button action=trustPrinter disabled=$notTrusted "Trust this device"
      For each=$printerDiagnostics
        Alert $item.message
      Button action=close cancel=true "Done"
  If condition=$printDialog
    Card variant=dialog aria-label="Confirm print"
      Heading level=2 "Ready to start this print?"
      Alert tone=error $error
      Text $printSummary
      Text "Check the physical bed, nozzle, plate and loaded material. Starting sends this exact archive to the selected printer."
      Checkbox name=useAMS label="Use the connected AMS lite"
      If condition=$useAMS
        For each=$materialMappings
          Field label=$item.label
            Select name=$item.name options=$trayOptions
        Checkbox name=acceptTrayDifferences label="I reviewed and accept any color / preset differences"
      Else
        Checkbox name=externalConfirmed label="The correct single filament is loaded on the external spool"
      Checkbox name=bedLeveling label="Run bed leveling"
      Checkbox name=printConfirmed label="I checked this physical printer and want to start now"
      Row
        Button variant=primary action=print disabled=$printNotConfirmed "Print now"
        Button action=close cancel=true "Back"
  If condition=$driveDialog
    Card variant=dialog aria-label="Open from Drive"
      Heading level=2 "Open STL or Bambu 3MF from Drive"
      Alert tone=error $error
      Field label=Source
        Select name=driveSource options=$driveSources
      Text $driveFolder
      Button action=driveUp "Parent folder"
      For each=$driveEntries
        Button item=$item.path action=driveEntry $item.label
      Button action=close cancel=true "Close"
