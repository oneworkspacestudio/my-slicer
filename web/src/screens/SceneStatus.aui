Page SceneStatus variant=scene-status
  If condition=$loading
    Alert
      Stack gap=xs
        Row
          Spinner
          Text $loading
        Text variant=caption "Your model will appear here. You can keep moving the view while it loads."
  If condition=$error
    Alert tone=error $error
    Button variant=secondary action=retry "Retry model preview"
  If condition=$ready
    Text variant=caption "Model ready"
