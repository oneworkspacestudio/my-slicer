Page Preview variant=studio-workbench
  Section id=printer-rail
  Stack variant=stage
    Row variant=toolstrip
      Icon name=Layers size=22
      Text $plateName
      Spacer
      Link href="#" "Back to Prepare"
    Section id=scene
    If condition=$activeSlice
      Card variant=slice-result
        Row
          Heading level=3 "Slicing Result"
          Spacer
          Text $sliceTitle
        Divider
        If condition=$sliceReady
          Field label="Color scheme" variant=inline
            Select name=feature options=$featureOptions
          Row variant=result-columns
            Text "Filament"
            Spacer
            Text "Total"
          Row
            Text $filamentText
          Divider
          Heading level=3 "Time Estimation"
          Text $timeText
          Text $layerCount
        Text variant=caption $activeSlice.message
        Text variant=caption $sliceElapsed
        If condition=$slicing
          Spinner
          Button variant=secondary action=cancelSlice "Cancel slicing"
        If condition=$sliceReady
          Button variant=secondary action=downloadSlice "Export sliced 3MF"
          If condition=$noSliceTarget
            Link href="#printers" "Add a printer to print directly"
          Else
            Button action=reviewPrint disabled=$cannotReviewPrint "Print plate"
          If condition=$staleSlice
            Alert tone=warning $staleReason
        If condition=$sliceFailed
          Alert tone=warning "Your model is kept. Return to Prepare to adjust the settings and try again."
          Link href="#" variant=button "Return to Prepare"
          Button variant=secondary action=downloadTroubleshooting "Download troubleshooting report"
          Text variant=caption "Contains print settings and engine warnings. No model files or sign-in details."
      If condition=$sliceReady
        Stack variant=layer-slider
          Text $maxLayer
          Input name=layer type=range min=1 max=$maxLayer step=1 aria-label="Preview layer"
          Text $layerText
        Row variant=path-slider
          Icon name=ChevronsRight size=18
          Input name=pathPercent type=range min=1 max=100 step=1 aria-label="Visible toolpath percentage"
          Text $pathText
    Else
      Stack variant=stage-empty
        Icon name=Layers size=40
        Heading level=1 "Your slice will appear here"
        Text "Add a model on Prepare and select Slice plate."
        Link href="#" variant=button "Go to Prepare"
    Row variant=stage-status
      Text variant=caption $sceneNotice
